# ============ LLM 提供商密钥（只需填写你在用的那个） ============
# 具体由 TRADINGAGENTS_LLM_PROVIDER 决定走哪家
OPENAI_API_KEY=
# Google Gemini
GOOGLE_API_KEY=
# Claude
ANTHROPIC_API_KEY=
# xAI Grok
XAI_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# 阿里云百炼（国际站）
DASHSCOPE_API_KEY=
# 阿里云百炼（中国站）
DASHSCOPE_CN_API_KEY=
# 智谱 GLM（国际站）
ZHIPU_API_KEY=
# 智谱 GLM（中国站）
ZHIPU_CN_API_KEY=
# MiniMax（国际站）
MINIMAX_API_KEY=
# MiniMax（中国站）
MINIMAX_CN_API_KEY=
# OpenRouter 聚合网关
OPENROUTER_API_KEY=
# Mistral
MISTRAL_API_KEY=
# 月之暗面 Kimi
MOONSHOT_API_KEY=
# Groq（Llama 等开源模型，速度快）
GROQ_API_KEY=
# NVIDIA NIM
NVIDIA_API_KEY=

# FRED 宏观经济数据（美联储：利率、通胀、就业、增长）。
# 免费申请 key：https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# 可选：自定义 OpenAI 兼容端点（vLLM、LM Studio、llama.cpp、中转服务等）。
# 将提供商设为 "openai_compatible" 并配置 base URL；key 可选（本地服务无需）。
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock（提供商 "bedrock"，安装：pip install ".[bedrock]"）。
# 认证方式二选一：Bedrock API key（bearer token，无需 AWS 访问密钥）或
# AWS 凭证链（环境变量 / ~/.aws/credentials / IAM 角色 / AWS_PROFILE）。
# 无论哪种方式都要设置区域；两者同时存在时 bearer token 优先。
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# 可选：指向远程 Ollama 服务。不设置时默认使用本地实例
# http://localhost:11434/v1。CLI 下拉选择和程序化客户端都会读取此值。
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# ============ 研究分析默认配置 ============
# 无需改代码即可覆盖 DEFAULT_CONFIG：下方任意 TRADINGAGENTS_* 变量设置后，
# 会替换 tradingagents/default_config.py 中的同名配置项。值会按原默认值
# 的类型自动转换（bool / int / str），因此 "true"/"3" 都能正常生效。
# 在 CLI 中设置提供商 / 模型 / 后端 URL / 语言，还会跳过对应的交互式
# 选择步骤（对 opencode、LM Studio 等 OpenAI 兼容端点和无人值守运行很有用）。
# 使用的 LLM 提供商
#TRADINGAGENTS_LLM_PROVIDER=openai
# 深度思考模型（研究员）
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
# 快速思考模型（交易员等）
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# OpenAI 兼容端点地址
#TRADINGAGENTS_LLM_BACKEND_URL=
# 报告输出语言
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
# 分析师辩论轮数
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# 风控讨论轮数
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
# 是否启用检查点（断点续跑）
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# 采样温度（越低，支持该参数的模型运行间差异越小）。
# 不设置则使用各提供商默认值。见 README 的"可复现性"说明——
# 没有任何设置能让 LLM 输出完全确定。
#TRADINGAGENTS_TEMPERATURE=0.0
# LLM SDK 重试次数上限，对所有提供商生效。不设置则用各 SDK 默认值
# （通常为 2）。遇到突发 429 限流（如 Azure OpenAI）时可调大以等待
# 恢复，而不是直接中断运行。
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# 输出 token 上限，对所有提供商生效（含 Gemini 的 max_output_tokens）。
# 不设置则用各提供商默认值。设置后可限制某些模型无限输出推理内容、
# 导致挂起或触发网关空闲超时的问题。
#TRADINGAGENTS_MAX_TOKENS=8192
# 各提供商的推理/思考深度（可选；不设置 = 提供商默认值）。
# 设置后也会跳过对应的交互式提示。
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# ============ 数据源（可选） ============
# SEC EDGAR 公共数据无需 API Key。需声明 User-Agent，下面沿用官方的应用名＋联系邮箱示例格式。
# 配置后可运行 python scripts/check_sec_access.py --cik 1045810 --output-dir /tmp/sec-check
# 联系邮箱会作为 User-Agent 发送给 SEC；仅填写你用于此用途的地址。
# 行业分析师优先使用 SEC_USER_AGENT；未配置时复用项目已授权的 COMMERCE_SUPPORT_EMAIL。
# 每进程统一限速每秒 1 次；403/429 停止该次分析中的 SEC 网络请求。邮箱不写入报告或订单。
#SEC_USER_AGENT=TradingAgents contact@your-domain.com
# 行业来源组合和关联公司上限在 config 中设置：industry_sources、industry_max_related_companies（0–3）。
# 来源包括 sec/fmp/fred/company_ir/census/eia/wsts，默认全部启用，按行业选择适用指标。
# 这两个 config 字段没有环境变量映射；部署配置和验收见 docs/付费报告部署与运行.md 第 3.5、11.4 节。
# FMP 稳定 API（fmpsdk）：美股行情、证券信息、财务数据、新闻与内部人交易。
# 付费网站默认：这些类别走 fmp + 本地技术指标。
# 本地 CLI/Web 的上述原有类别默认：yfinance。只填 key 即可保持两种默认值互不影响。
# 新增行业角色的来源独立组合；即使上述类别使用 Yahoo，默认行业 FMP 来源仍会使用此 Key。
# 端点访问与商业展示权限需要相应的 FMP 协议授权。
FMP_API_KEY=
# 可选 Marketstack V2 数据源：美股日线行情与证券元数据
MARKETSTACK_API_KEY=
# 以下选择器会覆盖【所有】共享此环境文件的入口的默认数据源。
# 保持注释状态即可让付费网站与本地使用各自的默认值。
#TRADINGAGENTS_CORE_STOCK_VENDOR=fmp
#TRADINGAGENTS_TECHNICAL_INDICATORS_VENDOR=local
#TRADINGAGENTS_INSTRUMENT_VENDOR=fmp
#TRADINGAGENTS_FUNDAMENTAL_VENDOR=fmp
#TRADINGAGENTS_NEWS_VENDOR=fmp

# ETF 基金资料使用 fundamental_data（FMP / Yahoo），需有对应持仓接口权限。
# ETF 付费报告开关：默认关闭；确认接口权限后改 true 并重启服务。
# 仅控制新 ETF 订单；已有订单、本地分析和 SPY 基准行情不受影响。
TRADINGAGENTS_ETF_REPORTS_ENABLED=false
# 开启后仍按以下名单验证购买资格；关闭开关无需删除名单。
#TRADINGAGENTS_ETF_ALLOWLIST=SPY,QQQ,VOO,IVV,VTI,DIA,IWM

# ============ 按次付费股票/ETF 报告网站（可选，pip install '.[mvp]'） ============
# 启动命令：tradingagents-mvp serve（默认 127.0.0.1:8000）
# 必填的网站配置项会在启动前做校验。
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# 购买按钮点不了的两种原因（满足其一即关闭销售）：
#   1. COMMERCE_SALES_ENABLED 不是 true
#   2. 下方"必填"项有任何一项为空
# 本地测试最省事的做法：SALES_ENABLED=true + RECAPTCHA_ENABLED=false，
# 再把 Creem / Resend 的几项填上即可点亮按钮。
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

# 对外访问地址（必须是 origin，不带路径；CREEM_MODE=prod 时强制 https）
COMMERCE_PUBLIC_URL=http://localhost:8000
# 总开关：false 时按钮始终为"Report purchases opening soon"
#COMMERCE_SALES_ENABLED=true
# 订单数据库和报告快照的存放目录（默认 ~/.tradingagents/commerce）
#COMMERCE_DATA_DIR=/absolute/persistent/path/commerce

# ---- Creem 收银台（生产: prod / 测试: test）----
# 一份 .env 同时管理两个 Creem 环境；其余配置共享。
# CLI 覆盖：tradingagents-mvp serve --mode test（或 --mode prod）。
CREEM_MODE=test
# 以下三项为【必填】：来自 Creem 控制台
# 测试环境：产品 ID（固定 $5.99 USD）/ API 密钥 / Webhook 签名密钥（回调验签用）
CREEM_TEST_PRODUCT_ID=
CREEM_TEST_API_KEY=
CREEM_TEST_WEBHOOK_SECRET=
# 生产环境：产品 ID / API 密钥 / Webhook 签名密钥
CREEM_PROD_PRODUCT_ID=
CREEM_PROD_API_KEY=
CREEM_PROD_WEBHOOK_SECRET=

# ---- 邮件通知（Resend）----
# 【必填】Resend API 密钥
RESEND_API_KEY=
# 【必填】发件人地址，如 reports@example.com
COMMERCE_EMAIL_FROM=
# 【必填】客服/支持邮箱（展示在页面上）
COMMERCE_SUPPORT_EMAIL=

# ---- Google reCAPTCHA v2 复选框 ----
# 注意：这里的 key 与上面 Google Gemini 的 GOOGLE_API_KEY 无关，需单独申请。
# key 为空时启动会失败；仅 CREEM_MODE=test 允许关闭。
COMMERCE_RECAPTCHA_ENABLED=true
# 【开启时必填】站点密钥（前端）
RECAPTCHA_SITE_KEY=
# 【开启时必填】密钥（服务端校验）
RECAPTCHA_SECRET_KEY=

# ---- 限流与队列 ----
# 每 IP 滚动 60 秒的请求上限（正整数；改完需重启）
# 下单接口限流
COMMERCE_CHECKOUT_RATE_LIMIT=5
# 报告查看限流
COMMERCE_READ_RATE_LIMIT=60
# 仅信任真实反向代理的地址；绝不要设为 '*' 暴露服务
#COMMERCE_FORWARDED_ALLOW_IPS=127.0.0.1
# 最大并行排队数
#COMMERCE_MAX_PENDING_RUNS=3
# 报告卡住多久判定为失速（秒）
#COMMERCE_STALLED_AFTER_SECONDS=1800
